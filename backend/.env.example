NODE_ENV=development
PORT=5000

# MongoDB Atlas (required)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/dtnemergency?retryWrites=true&w=majority

# JWT — mobile users (required)
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT — admins (required; must differ from mobile secrets)
ADMIN_JWT_SECRET=change_me_admin_access_secret
ADMIN_JWT_REFRESH_SECRET=change_me_admin_refresh_secret
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (required) — sole mobile identity provider
GOOGLE_CLIENT_ID=your_google_client_id
# Dev/test only. Ignored (and refused at boot) when NODE_ENV=production.
# Accepts mock:<googleAccountId>:<displayName>
GOOGLE_AUTH_MOCK=false

# Ed25519 certificate-signing private key (required — never commit)
# Generate with: npm run generate:cert-keypair
CERT_SIGNING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Optional on server (used by local verify helpers). Android must bake the public key in-app.
CERT_SIGNING_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Admin frontend origin(s) for CORS (required) — never "*"
# Comma-separate multiple origins if needed.
# Production example (Vercel SPA + local Vite):
# ADMIN_ORIGIN=https://fyp-lbrce.vercel.app,http://localhost:5173
ADMIN_ORIGIN=https://fyp-lbrce.vercel.app,http://localhost:5173

# Optional in-memory rate limits (express-rate-limit MemoryStore)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_GENERAL_MAX=300
# RATE_LIMIT_SENSITIVE_MAX=20

# Optional seed inputs for scripts/seedAdmin.js
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=choose_a_strong_password
# ADMIN_SEED_ROLE=superadmin
